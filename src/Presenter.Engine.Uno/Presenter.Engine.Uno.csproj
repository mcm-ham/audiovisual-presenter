<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WPF needed for BitmapSource image loading (image slides) -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Presenter.Core\Presenter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- runs on LibreOffice's bundled python.exe next to soffice.exe -->
    <Content Include="slideshow_host.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
