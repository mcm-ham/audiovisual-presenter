<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- matches Presenter.Engine.Render (referenced for SofficeLocator) -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WPF needed for BitmapSource image loading (image slides) -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Presenter.Core\Presenter.Core.csproj" />
    <!-- SofficeLocator lives in the render engine -->
    <ProjectReference Include="..\Presenter.Engine.Render\Presenter.Engine.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- runs on LibreOffice's bundled python.exe next to soffice.exe -->
    <Content Include="slideshow_host.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
