<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Presenter.Core\Presenter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows: runs on LibreOffice's bundled python.exe next to soffice.exe;
         macOS: runs in-process inside soffice via the script provider (launch
         constraints on the bundled Python forbid spawning it ourselves) -->
    <Content Include="slideshow_host.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
