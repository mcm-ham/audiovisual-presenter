<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Loc="clr-namespace:Presenter.Resources"
    xmlns:Code="clr-namespace:Presenter.App_Code"
    x:Class="Presenter.BuildProgress"
    Title="BuildProgress" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" SystemDecorations="None" CanResize="False" ShowInTaskbar="False"
    FontSize="{Binding Source={x:Static Code:Config.instance}, Path=FontSizeBinding}">
    <StackPanel Margin="10">
        <ProgressBar Name="Progress" Width="300" Height="20" Minimum="0" Maximum="1" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CancelButton" Click="CancelButton_Click" Content="{x:Static Loc:Labels.BuildProgressCancel}" />
        </StackPanel>
    </StackPanel>
</Window>
