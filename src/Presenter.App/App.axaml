<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Presenter.App"
             Name="Audiovisual Presenter"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <!-- accent scale consumed by Fluent for focus rings, checkboxes, slider fills
             and the calendar's "today" cell; keep in sync with ThemeAccentBrush in
             Theme.axaml -->
        <Color x:Key="SystemAccentColor">#2563EB</Color>
        <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
        <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
        <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
        <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
        <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
        <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- the app-wide "Slate" look: palette tokens and control chrome -->
        <StyleInclude Source="/Theme.axaml" />
    </Application.Styles>
</Application>
